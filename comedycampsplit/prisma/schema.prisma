generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  password      String
  name          String
  username      String?       @unique
  bio           String?
  avatarUrl     String?
  status        UserStatus    @default(PENDING)
  role          Role          @default(PARTICIPANT)
  phone         String?
  adminNotes    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  payments      Payment[]
  contributions UserContribution[]
  expenses      Expense[]     @relation("ExpenseSubmitter")
}

enum UserStatus {
  PENDING
  APPROVED
  CONFIRMED_PAID
  PENDING_PAYMENT
  CANCELLED
}

enum Role {
  ADMIN
  PARTICIPANT
}

model Trip {
  id              String      @id @default(cuid())
  name            String      @default("Comedy Summer Camp")
  destination     String?
  startDate       DateTime?
  endDate         DateTime?
  description     String?
  itinerary       String?
  lodging         String?
  meals           String?
  isLocked        Boolean     @default(false)
  lockedAt        DateTime?
  finalPrice      Float?
  totalExpenses   Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  expenses        Expense[]
  contributions   Contribution[]
}

model Expense {
  id          String      @id @default(cuid())
  tripId      String
  trip        Trip        @relation(fields: [tripId], references: [id])
  submittedBy String?
  submitter   User?       @relation("ExpenseSubmitter", fields: [submittedBy], references: [id])
  title       String
  amount      Float
  category    String
  notes       String?
  receiptUrl  String?
  approved    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Contribution {
  id          String      @id @default(cuid())
  tripId      String
  trip        Trip        @relation(fields: [tripId], references: [id])
  title       String
  description String?
  category    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       UserContribution[]
}

model UserContribution {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  contributionId String
  contribution   Contribution @relation(fields: [contributionId], references: [id])
  notes          String?
  createdAt      DateTime     @default(now())

  @@unique([userId, contributionId])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amount          Float
  stripeSessionId String?       @unique
  stripePaymentId String?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}
