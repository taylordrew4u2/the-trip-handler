DATABASE_URL=
NEXTAUTH_SECRET=
# Required off Vercel. On Vercel it is ignored: NextAuth derives the origin
# from the request host instead, which is correct on previews too.
# See lib/authOrigin.ts and docs/seeding-the-demo.md.
NEXTAUTH_URL=http://localhost:3000

# Optional. Set to exactly "true" in a deployment's environment to seed the
# demo trip after each deploy's migrations. Off by default; see
# docs/seeding-the-demo.md for what re-seeding deletes.
SEED_DEMO=

# Optional: address that receives operational notifications (new guest
# forms, withdrawals). Leave blank to disable those emails.
ADMIN_EMAIL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
